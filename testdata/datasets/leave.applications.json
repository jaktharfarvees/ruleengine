{
  "datasetId": "leave.applications",
  "sourceService": "leave-service",
  "domain": "leave",
  "grain": "one row per leave application",
  "description": "Every leave application a tenant has recorded, in any status",
  "tenantScoped": true,
  "status": "published",
  "version": "1.0.0",
  "publishedAt": "2026-01-01T00:00:00Z",
  "maxWindowDays": 730,
  "rowLimit": 5000,
  "allowedAggregates": ["count", "sum", "max", "min", "avg", "streak", "latest", "exists"],
  "columns": [
    {"name": "employeeId", "dataType": "string", "filterable": true, "aggregatable": false, "windowable": false, "pii": true, "description": "Subject key"},
    {"name": "leaveType", "dataType": "enum", "filterable": true, "aggregatable": false, "windowable": false, "pii": false, "allowedValues": ["CASUAL", "ANNUAL", "SICK", "UNPAID"]},
    {"name": "status", "dataType": "enum", "filterable": true, "aggregatable": false, "windowable": false, "pii": false, "allowedValues": ["APPROVED", "PENDING", "REJECTED", "CANCELLED"]},
    {"name": "startDate", "dataType": "date", "filterable": true, "aggregatable": false, "windowable": true, "pii": false},
    {"name": "endDate", "dataType": "date", "filterable": true, "aggregatable": false, "windowable": true, "pii": false},
    {"name": "days", "dataType": "decimal", "filterable": false, "aggregatable": true, "windowable": false, "pii": false, "description": "Deliberately not filterable: no index is promised for it"},
    {"name": "isHalfDay", "dataType": "boolean", "filterable": true, "aggregatable": false, "windowable": false, "pii": false}
  ]
}
