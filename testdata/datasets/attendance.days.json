{
  "datasetId": "attendance.days",
  "sourceService": "attendance-service",
  "domain": "attendance",
  "grain": "one row per employee per work day",
  "description": "One row for each work day an employee was rostered",
  "tenantScoped": true,
  "status": "published",
  "version": "1.0.0",
  "publishedAt": "2026-01-01T00:00:00Z",
  "maxWindowDays": 365,
