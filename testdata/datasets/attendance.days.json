  "columns": [
    {"name": "employeeId", "dataType": "string", "filterable": true, "aggregatable": false, "windowable": false, "pii": true, "description": "Subject key"},
    {"name": "workDate", "dataType": "date", "filterable": true, "aggregatable": false, "windowable": true, "pii": false},
    {"name": "isLate", "dataType": "boolean", "filterable": true, "aggregatable": true, "windowable": false, "pii": false, "description": "Aggregatable so a streak can run over it"},
    {"name": "lateMinutes", "dataType": "integer", "filterable": true, "aggregatable": true, "windowable": false, "pii": false},
    {"name": "isAbsent", "dataType": "boolean", "filterable": true, "aggregatable": false, "windowable": false, "pii": false},
    {"name": "workedHours", "dataType": "decimal", "filterable": false, "aggregatable": true, "windowable": false, "pii": false, "description": "Deliberately not filterable, for the guardrail test"},
    {"name": "shiftCode", "dataType": "string", "filterable": true, "aggregatable": false, "windowable": false, "pii": false}
  ]
}
