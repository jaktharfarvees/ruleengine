{
  "ruleKey": "urn:arrowhr:rule:payroll:overtime:payment:v1",
  "domain": "payroll",
  "ruleSet": "overtime",
  "name": "payment",
  "description": "Approved individual exception: E9001 is paid overtime from the first hour",
  "version": "1.0.0",
  "changeType": "MAJOR",
  "status": "active",
  "tenant": "RWB",
  "scope": {
    "anchor": {
      "kind": "employee",
      "employeeId": "E9001",
      "reason": "Retention agreement approved by the CFO on 2025-12-18"
    },
    "filters": []
  },
  "effective": {"validFrom": "2026-01-01T00:00:00Z"},
  "declaredInputs": ["otHours"],
  "declaredOutputs": ["otPayable", "otHoursPaid", "rateMultiplier", "reasonCode"],
  "decisionType": "payroll-overtime",
  "logic": {
    "hitPolicy": "first",
    "rows": [
      {
        "id": "paid-from-first-hour",
        "when": {"otHours": "> 0"},
        "then": {
          "otPayable": true,
          "otHoursPaid": "$otHours",
          "rateMultiplier": "2.0",
          "reasonCode": "OT_INDIVIDUAL_EXCEPTION"
        }
      },
      {
        "id": "no-overtime",
        "when": {},
        "then": {
          "otPayable": false,
          "otHoursPaid": "0",
          "rateMultiplier": "1.0",
          "reasonCode": "OT_NONE_WORKED"
        }
      }
    ]
  },
  "guards": [],
  "engineRef": {"engine": "decisiontable"},
  "metadata": {
    "owner": "Payroll Operations",
    "createdBy": "rule-service",
    "createdAt": "2026-01-01T00:00:00Z",
    "changeNote": "Employee anchors outrank every node anchor; every output is restated"
  }
}
