            "op": "equals",
            "value": "$subject.employeeId"
          },
          {
            "attribute": "leaveType",
            "op": "equals",
            "value": "CASUAL"
          },
          {
            "attribute": "status",
            "op": "equals",
            "value": "APPROVED"
          }
        ],
        "window": {
          "column": "startDate",
          "relativeTo": "$validAt",
          "lastDays": 365
        },
        "aggregate": {
          "fn": "sum",
          "on": "days",
          "unit": "days"
        },
        "onEmpty": "0",
        "version": "1"
      },
      "factSourceVersion": "1",
      "effective": {},
