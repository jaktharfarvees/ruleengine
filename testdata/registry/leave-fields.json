    {
      "name": "availableBalance",
      "domain": "leave",
      "dataType": "decimal",
      "unit": "days",
      "pii": false,
      "ownerService": "leave-service",
      "status": "active",
      "role": "input",
      "factSource": {
        "kind": "dataset",
        "dataset": "leave.balances",
        "filters": [
          {
            "attribute": "employeeId",
            "op": "equals",
            "value": "$subject.employeeId"
          },
          {
            "attribute": "leaveType",
            "op": "equals",
            "value": "ANNUAL"
          }
        ],
        "window": {
          "column": "asOfDate",
          "relativeTo": "$validAt",
          "lastDays": 366
        },
        "aggregate": {
          "fn": "latest",
          "on": "balanceDays",
          "unit": "days"
        },
        "onEmpty": "0",
        "version": "1"
      },
      "factSourceVersion": "1",
      "effective": {},
      "description": "Annual-leave balance at validAt, the dataset-sourced reference field"
    },
    {
      "name": "accruedBalanceToDate",
      "domain": "leave",
      "dataType": "decimal",
