{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:dataset-manifest:v2",
  "title": "Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "sourceService",
    "domain",
    "status",
    "maxWindowDays",
    "allowedAggregates",
    "columns"
  ],
  "properties": {
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "sourceService": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "grain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tenantScoped": {
      "type": "boolean",
      "const": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxWindowDays": {
      "type": "integer",
      "minimum": 1
    },
    "rowLimit": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional per-dataset cap on rows scanned. The fact budget caps a whole request; this caps this dataset, and the lower of the two applies."
    },
    "allowedAggregates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "count",
          "sum",
          "max",
          "min",
          "avg",
          "streak",
          "latest",
          "exists"
        ]
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dataType",
        "filterable",
        "aggregatable",
        "windowable",
        "pii"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataType": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "decimal",
            "number",
            "boolean",
            "date",
            "datetime",
            "enum",
            "money"
          ]
        },
        "filterable": {
          "type": "boolean"
        },
        "aggregatable": {
          "type": "boolean"
        },
        "windowable": {
          "type": "boolean"
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pii": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
