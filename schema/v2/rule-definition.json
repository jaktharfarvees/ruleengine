{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:rule-definition:v2",
  "title": "Rule Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleKey", "domain", "ruleSet", "name", "version", "changeType", "status", "tenant", "anchor", "effective", "declaredInputs", "declaredOutputs", "decisionType", "logic", "engineRef", "metadata"],
  "properties": {
    "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
    "domain": {"type": "string", "minLength": 1},
    "ruleSet": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "changeType": {"type": "string", "enum": ["MINOR", "MAJOR"]},
    "status": {"type": "string", "enum": ["draft", "pending-approval", "active", "scheduled", "deprecated", "retired"]},
    "tenant": {"type": "string", "minLength": 1},
    "anchor": {"$ref": "#/$defs/anchor"},
    "attributeFilters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
    "tieBreakPriority": {"type": "integer"},
    "conflictPolicy": {"type": "string"},
    "effective": {
      "type": "object", "additionalProperties": false, "required": ["validFrom"],
      "properties": {
        "validFrom": {"type": "string", "format": "date-time"},
        "validTo": {"type": "string", "format": "date-time"}
      }
    },
    "declaredInputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "declaredOutputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decisionType": {"type": "string", "minLength": 1},
    "logic": {
      "type": "object", "additionalProperties": false, "required": ["hitPolicy", "rows"],
      "properties": {
        "hitPolicy": {"type": "string", "enum": ["first", "priority", "collect"]},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
      }
    },
    "guards": {"type": "array", "items": {"type": "string"}},
    "engineRef": {
      "type": "object", "additionalProperties": false, "required": ["engine"],
      "properties": {"engine": {"type": "string", "minLength": 1}}
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["owner", "createdBy", "createdAt"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "createdBy": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "changeNote": {"type": "string"},
        "approvedBy": {"type": "string"},
        "approvedAt": {"type": "string", "format": "date-time"},
        "templateId": {"type": "string"},
        "templateVersion": {"type": "string"}
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false, "required": ["nodeId"],
      "properties": {
        "kind": {"const": "node"},
        "nodeId": {"type": "string", "minLength": 1}
      }
    },
    "filter": {
      "type": "object", "additionalProperties": false, "required": ["attribute", "op"],
      "properties": {
        "attribute": {"type": "string", "minLength": 1},
        "op": {"type": "string", "enum": ["equals", "in", "notIn", "range", "exists", "notExists"]},
        "value": {}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false, "required": ["id", "when", "then"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "when": {"type": "object"},
        "then": {"type": "object"},
        "note": {"type": "string"},
        "priority": {"type": "integer"}
      }
    }
  }
}

