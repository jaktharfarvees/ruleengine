{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:evaluation-response:v2",
  "title": "Evaluation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "reasonCodes", "failed", "asOf", "validAt", "libVersion"],
  "properties": {
    "decisionId": {"type": "string", "minLength": 1},
    "ruleKey": {"type": "string"},
    "ruleVersion": {"type": "string"},
    "decisionType": {"type": "string"},
    "result": {"type": "object"},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resolvedAt": {"type": "string", "minLength": 1},
    "anchorPath": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evaluated": {"type": "array", "items": {"$ref": "#/$defs/evaluated"}},
    "factsResolved": {"type": "array", "items": {"type": "object"}},
    "resolvedAttributes": {"type": "object"},
    "obligations": {"type": "array", "items": {"type": "string"}},
    "failed": {"type": "boolean"},
    "tie": {"type": "object"},
    "asOf": {"type": "string", "format": "date-time"},
    "validAt": {"type": "string", "format": "date-time"},
    "runId": {"type": "string"},
    "hierarchySnapshotId": {"type": "string"},
    "correlationId": {"type": "string"},
    "traceparent": {"type": "string"},
    "trace": {"type": "object"},
    "libVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleKey", "ruleVersion", "order", "depth", "onPath", "filtersMatched", "winner"],
      "properties": {
        "ruleKey": {"type": "string"},
        "ruleVersion": {"type": "string"},
        "anchorNodeId": {"type": "string"},
        "order": {"type": "integer"},
        "depth": {"type": "integer"},
        "onPath": {"type": "boolean"},
        "filtersMatched": {"type": "boolean"},
        "winner": {"type": "boolean"},
        "eliminatedBy": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}

