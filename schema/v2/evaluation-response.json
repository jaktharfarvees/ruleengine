{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:evaluation-response:v2",
  "title": "Evaluation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "reasonCodes", "failed", "asOf", "validAt", "libVersion"],
  "if": {
    "properties": {
      "reasonCodes": {"type": "array", "contains": {"const": "OK"}}
    },
    "required": ["reasonCodes"]
  },
  "then": {
    "required": ["ruleKey", "ruleVersion", "decisionType", "result", "resolvedAt", "evaluated", "anchorPath"]
  },
  "properties": {
    "decisionId": {"type": "string", "minLength": 1},
    "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
    "ruleVersion": {"type": "string", "minLength": 1},
    "decisionType": {"type": "string", "minLength": 1},
    "result": {"type": "object"},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resolvedAt": {"type": "string", "minLength": 1},
    "anchorPath": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evaluated": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evaluated"}},
    "factsResolved": {"type": "array", "items": {"$ref": "#/$defs/factResolved"}},
    "resolvedAttributes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/resolvedAttribute"}
    },
    "obligations": {"type": "array", "items": {"type": "string"}},
    "failed": {"type": "boolean"},
    "tie": {"$ref": "#/$defs/tie"},
    "asOf": {"type": "string", "format": "date-time"},
    "validAt": {"type": "string", "format": "date-time"},
    "runId": {"type": "string", "minLength": 1},
    "hierarchySnapshotId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "traceparent": {"type": "string", "minLength": 1},
    "trace": {"type": "object"},
    "libVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleKey", "ruleVersion", "anchorNodeId", "order", "depth", "onPath", "filtersMatched", "winner"],
      "if": {"properties": {"winner": {"const": false}}, "required": ["winner"]},
      "then": {"required": ["eliminatedBy", "reason"]},
      "properties": {
        "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
        "ruleVersion": {"type": "string", "minLength": 1},
        "anchorNodeId": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 0},
        "onPath": {"type": "boolean"},
        "filtersMatched": {"type": "boolean"},
        "winner": {"type": "boolean"},
        "eliminatedBy": {"type": "string", "enum": ["not-on-path", "filters", "effective-date", "status", "cross-tenant", "lower-order", "tie-break"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "factResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "kind", "cached", "fromRequest"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["passed", "derived", "native", "dataset"]},
        "factSourceVersion": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "rowsScanned": {"type": "integer", "minimum": 0},
        "elapsedMs": {"type": "integer", "minimum": 0},
        "cached": {"type": "boolean"},
        "fromRequest": {"type": "boolean"}
      }
    },
    "resolvedAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "sourceNodeId"],
      "properties": {
        "value": {"type": "string"},
        "sourceNodeId": {"type": "string", "minLength": 1}
      }
    },
    "tie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "order", "depth", "message"],
      "properties": {
        "candidates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ruleKeyVersion"}},
        "order": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 0},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "ruleKeyVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleKey", "version"],
      "properties": {
        "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}

