{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:evaluation-response:v2",
  "title": "Evaluation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "reasonCodes", "failed", "asOf", "validAt", "libVersion"],
  "properties": {
    "decisionId": {"type": "string", "minLength": 1},
    "ruleKey": {"type": "string"},
    "ruleVersion": {"type": "string"},
    "decisionType": {"type": "string"},
    "result": {"type": "object"},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resolvedAt": {"type": "object"},
    "subjectPath": {"type": "array", "items": {"type": "object"}},
    "evaluated": {"type": "array", "items": {"type": "object"}},
    "factsResolved": {"type": "array", "items": {"type": "object"}},
    "resolvedAttributes": {"type": "object"},
    "obligations": {"type": "array", "items": {"type": "string"}},
    "failed": {"type": "boolean"},
    "tie": {"type": "object"},
    "asOf": {"type": "string", "format": "date-time"},
    "validAt": {"type": "string", "format": "date-time"},
    "runId": {"type": "string"},
    "correlationId": {"type": "string"},
    "traceparent": {"type": "string"},
    "trace": {"type": "object"},
    "libVersion": {"type": "string", "minLength": 1}
  }
}

