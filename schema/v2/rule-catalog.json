{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:rule-catalog:v2",
  "title": "Rule Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogManifestId", "tenant", "entries"],
  "properties": {
    "catalogManifestId": {"type": "string", "minLength": 1},
    "tenant": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "defaults": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/defaultPolicy"}}
  },
  "$defs": {
    "effective": {
      "type": "object", "additionalProperties": false, "required": ["validFrom"],
      "properties": {
        "validFrom": {"type": "string", "format": "date-time"},
        "validTo": {"type": "string", "format": "date-time"}
      }
    },
    "filter": {
      "type": "object", "additionalProperties": false, "required": ["attribute", "op"],
      "properties": {
        "attribute": {"type": "string", "minLength": 1},
        "op": {"type": "string", "enum": ["equals", "in", "notIn", "range", "exists", "notExists"]},
        "value": {}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleKey", "domain", "ruleSet", "anchorNodeId", "effective", "decisionType", "loaderKey"],
      "properties": {
        "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
        "domain": {"type": "string", "minLength": 1},
        "ruleSet": {"type": "string", "minLength": 1},
        "anchorNodeId": {"type": "string", "minLength": 1},
        "attributeFilters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "effective": {"$ref": "#/$defs/effective"},
        "decisionType": {"type": "string", "minLength": 1},
        "loaderKey": {"type": "string", "minLength": 1}
      }
    },
    "defaultPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "ruleSet", "name", "decisionType", "result", "reasonCode", "authorizedBy", "authorizedAt"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "ruleSet": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "decisionType": {"type": "string", "minLength": 1},
        "result": {"type": "object"},
        "reasonCode": {"type": "string", "minLength": 1},
        "authorizedBy": {"type": "string", "minLength": 1},
        "authorizedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
