{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:evaluation-request:v2",
  "title": "Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenant", "routing", "subject", "context", "asOf"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "tenant": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "ruleKey"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "ruleSet": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "ruleKey": {"type": "string", "pattern": "^urn:arrowhr:rule:[^:]+:[^:]+:[^:]+:v[1-9][0-9]*$"},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "identifier", "nodeId"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "identifier": {"$ref": "#/$defs/identifier"},
        "alternateIdentifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "nodeId": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      }
    },
    "resource": {"type": "object"},
    "context": {"type": "object"},
    "employmentCountry": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "asOf": {"type": "string", "format": "date-time"},
    "validAt": {"type": "string", "format": "date-time"},
    "runId": {"type": "string", "minLength": 1},
    "ruleVersionPin": {"type": "string", "minLength": 1},
    "factSourcePins": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "idempotencyKey": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "traceparent": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "value", "idType"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "idType": {"type": "string", "minLength": 1}
      }
    }
  }
}

