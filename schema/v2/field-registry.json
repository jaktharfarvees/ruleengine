{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:field-registry:v2",
  "title": "Field Registry",
  "anyOf": [
    {"type": "array", "items": {"$ref": "#/$defs/field"}},
    {
      "type": "object", "additionalProperties": false, "required": ["fields"],
      "properties": {"fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}}
    }
  ],
  "$defs": {
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "domain", "dataType", "pii", "ownerService", "status", "role", "effective"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "dataType": {"type": "string", "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "enum", "money"]},
        "unit": {"type": "string"},
        "allowedValues": {"type": "array", "items": {"type": "string"}},
        "pii": {"type": "boolean"},
        "ownerService": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "status": {"type": "string"},
        "role": {"type": "string", "enum": ["input", "output", "subjectAttribute"]},
        "factSource": {"type": "object"},
        "factSourceVersion": {"type": "string"},
        "effective": {"type": "object"},
        "updatedBy": {"type": "string"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}

