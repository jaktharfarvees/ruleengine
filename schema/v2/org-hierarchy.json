{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arrowhr:schema:org-hierarchy:v2",
  "title": "Organization Hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": ["types", "nodes"],
  "properties": {
    "types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/type"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "type": {
      "type": "object", "additionalProperties": false,
      "required": ["typeId", "typeName", "order", "tenant", "status"],
      "properties": {
        "typeId": {"type": "string", "minLength": 1},
        "typeName": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "tenant": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "tenant", "typeId", "name", "status"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "code": {"type": "string"},
        "tenant": {"type": "string", "minLength": 1},
        "typeId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "parentNodeId": {"type": "string"},
        "status": {"type": "string"},
        "country": {"type": "string"},
        "currency": {"type": "string"},
        "locale": {"type": "string"},
        "timezone": {"type": "string"}
      }
    }
  }
}

